# 复制为 .env 后，通过 `uv run --env-file .env poe test-live` 运行真实请求测试。
# .env 已被 Git 忽略；请勿提交账号、密码、Cookie、Token 或测试输出。
# 校园网/VPN 联调默认直连；确实依赖系统代理时设为 false。
TEST_DIRECT=true
# 用于测试的账号的密码
TEST_STU_ID=
TEST_PASSWORD=
# 用于测试的学年和学期信息
TEST_XN=2025
TEST_XQ=1
# 用于测试的日期信息
TEST_YEAR=2026
TEST_MONTH=3
TEST_DAY=10
# 宿舍信息，填写内容应满足 Python Dormitory.from_parsed_value 的参数要求
TEST_DORMITORY_PARK=财院校区
TEST_DORMITORY_BUILD=A
TEST_DORMITORY_ROOM=A301
# 用于测试大物实验平台的信息
# 密码
TEST_LAB_PASSWORD=
# 大物实验平台登录的最大尝试次数
TEST_LAB_MAX_TRIED=5
# 大物实验平台下测试用到的 semester id
TEST_LAB_SEMESTER_ID=18
# 大物实验平台下测试用到的 course id
TEST_LAB_COURSE_ID=68
# 用于教务系统的测试信息
TEST_HDJW_JX0404ID=
TEST_HDJW_BUILDING_ID=106
# 学期的第几周
TEST_HDJW_WEEK=7
# 一周的第几天
TEST_HDJW_DAY_OF_WEEK=3
# 上课的节次（大节次）
TEST_HDJW_TIME=1,2
# 用于研究生系统的测试信息
# 研究生系统下测试用到的 semester id
TEST_YJSXT_SEMESTER_ID=18
# 用于 CG 系统的测试信息
TEST_CG_PASSWORD= # 密码
# 验证码图片的保存目录
TEST_CG_CAPTCHA_DIR=.local
